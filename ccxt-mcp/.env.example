# Existing aliases supported by this service:
TRADINGAGENTS_PROXY_URL=http://127.0.0.1:7890
BINANCE_API_KEY=
BINANCE_API_SECRET=

# CCXT MCP settings:
CCXT_EXCHANGE_ID=binance
CCXT_DEFAULT_TYPE=future
CCXT_SANDBOX=false
CCXT_TIMEOUT_MS=30000
CCXT_IP_CHECK_URL=https://api.ipify.org?format=json
CCXT_WHITELIST_IPS=

# Trading is disabled unless both settings below allow it.
CCXT_ENABLE_TRADING=false
CCXT_DRY_RUN=true
